  "files": [
    "build"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.0",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["mcp", "dio", "trilha", "desafio", "certificado"],
