{
  "name": "dio-explorer-mcp",
  "version": "1.0.0",
  "description": "MCP Server para o DIO Explorer — expõe /trilha, /desafio e /certificado via Model Context Protocol",
  "type": "module",
  "bin": {
    "dio-explorer-mcp": "./build/index.js"
  },
  "scripts": {
